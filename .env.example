# 7FX Finance
# MySQL connection string (cPanel / local)
# Example cPanel: mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/deskflow_trade"

# On Netlify with Netlify Database: you may omit DATABASE_URL when NETLIFY=true;
# runtime then uses getConnectionString() from @netlify/database.
# Note: Prisma schema provider is mysql — Netlify Postgres is not compatible
# unless you point DATABASE_URL at a MySQL instance.

# JWT session signing secret (required in production)
# Generate: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Optional alias — used only if AUTH_SECRET is unset
# JWT_SECRET=""

# Optional: protect POST /api/seed (falls back to AUTH_SECRET)
# SEED_SECRET=""

# Optional: bind address for custom server (cPanel usually sets PORT only)
# HOSTNAME="0.0.0.0"
# PORT="3000"

# Production admin bootstrap (required in production — no default Admin123!)
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=use-a-strong-secret
# ADMIN_ROTATE_PASSWORD=1
# ALLOW_DEMO_SEED=0

# Public site URL (auto-login redirects / shareable CRM links; required behind Railway bind 0.0.0.0)
# NEXT_PUBLIC_APP_URL=https://7fx.customer.org.tr
# NEXT_PUBLIC_SITE_URL=https://7fx.customer.org.tr
