# 7FX Finance — Natro cPanel / local
# Copy to .env on the server OR set via cPanel → Setup Node.js App → Environment variables.
# Never commit real secrets.

# --- Required ---
# MySQL (cPanel → MySQL® Databases). Host is almost always localhost on Natro.
# URL-encode special chars in password: @ → %40  # → %23  % → %25
DATABASE_URL="mysql://CPANELUSER_dbuser:PASSWORD@localhost:3306/CPANELUSER_dbname"

# JWT session signing (required in production)
# Generate: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Public URL of this deployment (cookies, redirects, share links)
NEXT_PUBLIC_APP_URL=https://7fx.control.org.tr
# Optional alias used by some helpers
# NEXT_PUBLIC_SITE_URL=https://7fx.control.org.tr

# --- Strongly recommended ---
# Live support / AI assistant (omit to disable AI features)
OPENAI_API_KEY=
SUPPORT_AI_MODEL=gpt-4.1-mini
# AI_ASSISTANT_MODEL=gpt-4.1-mini

# Web Push (admin/trader notifications). Generate with web-push:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:llvad@icloud.com

# --- Optional ---
# JWT_SECRET=          # used only if AUTH_SECRET unset
# SEED_SECRET=         # protect POST /api/seed
# HOST=0.0.0.0         # server.js bind (cPanel sets PORT)
# PORT=3000            # set automatically by Application Manager — do not override
NODE_ENV=production

# Production admin bootstrap (no default Admin123!)
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=use-a-strong-secret
# ADMIN_ROTATE_PASSWORD=1
ALLOW_DEMO_SEED=false

# Do NOT invent licenses / Barclays / sponsors — leave empty; add real ones in admin later.
