generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String           @id @default(cuid())
  email              String           @unique @db.VarChar(191)
  /// Optional login username (unique, case-insensitive via lower-case storage)
  username           String?          @unique @db.VarChar(64)
  /// 16-digit numeric login ID (Account ID) — digits only, unique
  accountLoginId     String?          @unique @db.VarChar(16)
  passwordHash       String
  /// Set when an admin sets a new password; sessions issued before this are rejected
  passwordChangedAt  DateTime?
  /// Client must set a new password before using the terminal (e.g. after forcePasswordReset auto-login)
  mustChangePassword Boolean          @default(false)
  name               String
  role               String           @default("TRADER") // TRADER | ADMIN
  /// Job title / role in company (informational only, see src/lib/job-titles.ts). Not an access role.
  jobTitle           String?          @db.VarChar(32)
  active             Boolean          @default(true)
  /// Separate from freeze (active): trader may open/close positions & orders
  tradingEnabled     Boolean          @default(true)
  /// Separate from freeze: trader may submit withdrawal requests
  withdrawalsEnabled Boolean          @default(true)
  /// Separate from freeze: password/auto-login & non-impersonation sessions
  loginEnabled       Boolean          @default(true)
  /// Admin-authored message shown in login popup when loginEnabled=false
  loginBlockedMessage String?         @db.Text
  /// When login was last disabled (CRM); sessions after this are rejected
  loginBlockedAt     DateTime?
  lastLoginAt        DateTime?
  /// Presence: last authenticated activity by the client (not admin impersonation)
  lastSeenAt         DateTime?
  lastIp             String?          @db.VarChar(64)
  lastUserAgent      String?          @db.VarChar(512)
  lastDevice         String?          @db.VarChar(32)
  lastBrowser        String?          @db.VarChar(64)
  lastOs             String?          @db.VarChar(64)
  /// ISO-3166 alpha-2 of the last seen IP
  lastCountry        String?          @db.VarChar(8)
  lastCountryName    String?          @db.VarChar(96)
  lastRegion         String?          @db.VarChar(128)
  lastCity           String?          @db.VarChar(128)
  /// Fine-grained ADMIN flags (ignored for TRADER)
  canManageUsers     Boolean          @default(true)
  canApproveDeposits Boolean          @default(true)
  canEditRates       Boolean          @default(true)
  canManageMethods   Boolean          @default(true)
  canAdjustBalance   Boolean          @default(true)
  /// When true, ADMIN may view all CRM pages/APIs but cannot mutate
  crmReadOnly        Boolean          @default(false)
  /// TOTP 2FA (ADMIN). Secret stored encrypted-at-rest via app secret XOR is overkill; keep server-only.
  totpSecret         String?          @db.VarChar(128)
  totpEnabled        Boolean          @default(false)
  /// Failed password attempts (reset on success)
  failedLoginCount   Int              @default(0)
  /// Account lockout until this time (null = not locked)
  lockedUntil        DateTime?

  /// Identity / membership
  firstName            String?
  lastName             String?
  phone                String?
  birthDate            DateTime?
  language             String           @default("en")
  timezone             String           @default("Europe/Istanbul")
  country              String?
  address              String?  @db.Text

  /// Account meta
  accountType          String           @default("STANDARD")
  registrationDate     DateTime?
  registrationCountry  String?
  isResident           Boolean          @default(false)

  /// Trading / CRM desk fields
  tradingServer        String?
  tradingGroup         String?
  desk                 String?
  deskId               String?
  campaign             String?
  affiliateA           String? // A_AID
  affiliateB           String? // B_BID
  affiliateC           String? // C_CID
  /// Referral/invite code used at registration (optional audit)
  referralCodeUsed     String?  @db.VarChar(64)
  retentionStatus      String?
  saleStatus           String?
  potentialStatus      String?
  validationStatus     String?
  ftd                  Boolean          @default(false)
  brokerName           String?
  assigneeName         String?

  /// Documents stub
  documentsStatus      String           @default("NONE") // NONE | PENDING | APPROVED | REJECTED

  createdAt          DateTime         @default(now())
  account            Account?
  orders             Order[]
  positions          Position[]
  deposits           DepositRequest[]
  balanceRequests    BalanceRequest[]
  withdrawals        WithdrawalRequest[]
  auditLogs          AuditLog[]       @relation("AdminAudits")
  notes              UserNote[]
  ledgerEntries      BalanceLedger[]
  communications     Communication[]
  clientActivityEvents ClientActivityEvent[]
  documents          DocumentRecord[]
  reminders          Reminder[]
  autoLoginLinks     AutoLoginLink[]  @relation("AutoLoginTarget")
  createdLoginLinks  AutoLoginLink[]  @relation("AutoLoginCreator")
  loginEvents        LoginEvent[]
  chatThreadState    ChatThreadState?

  @@index([lastSeenAt])
}

model Account {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance    Float    @default(0)
  equity     Float    @default(0)
  margin     Float    @default(0)
  freeMargin Float    @default(0)
  leverage   Int      @default(100)
  currency   String   @default("USD")
  credit     Float    @default(0)
  bonus      Float    @default(0)
  updatedAt  DateTime @updatedAt
}

model UserNote {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  authorId   String?
  authorName String?
  body       String   @db.Text
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

model Order {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol     String
  side       String // BUY | SELL
  type       String // MARKET | LIMIT | STOP
  volume     Float
  price      Float? // for limit/stop
  openPrice  Float?
  stopLoss   Float?
  takeProfit Float?
  status     String    @default("PENDING") // PENDING | FILLED | CANCELLED | REJECTED
  filledAt   DateTime?
  createdAt  DateTime  @default(now())
  positionId String?

  @@index([userId, status])
}

model Position {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol       String
  /// Catalog symbol for chart / live Yahoo feed; null = use symbol
  chartSymbol  String?
  side         String // BUY | SELL
  volume       Float
  openPrice    Float
  currentPrice Float
  stopLoss     Float?
  takeProfit   Float?
  profit       Float     @default(0)
  margin       Float     @default(0)
  status       String    @default("OPEN") // OPEN | CLOSED
  openedAt     DateTime  @default(now())
  closedAt     DateTime?
  closePrice   Float?
  closeProfit  Float?

  @@index([userId, status])
}

model DepositMethod {
  id            String           @id @default(cuid())
  type          String // IBAN | CRYPTO
  label         String
  active        Boolean          @default(true)
  bankName      String?
  accountHolder String?
  iban          String?
  asset         String?
  network       String?
  address       String?  @db.Text
  instructions  String?  @db.Text
  sortOrder     Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  requests      DepositRequest[]
}

model DepositRequest {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  methodId   String
  method     DepositMethod @relation(fields: [methodId], references: [id])
  amount     Float
  currency   String        @default("USD")
  note       String?  @db.Text
  status     String        @default("PENDING") // PENDING | APPROVED | REJECTED
  adminNote  String?  @db.Text
  /// Admin-written reason captured when the ticket is approved
  approvalReason String?   @db.Text
  /// Event narrative prepared at approval (AI or fact composer)
  eventScenario  String?   @db.Text
  createdAt  DateTime      @default(now())
  reviewedAt DateTime?

  @@index([userId, status])
  @@index([status])
}

/// Margin-call recovery requests (reset or add balance). Balance changes only after ADMIN approve.
model BalanceRequest {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String // RESET | ADD (RESET: admin/CRM only; traders may only request ADD)
  amount     Float? // required for ADD; ignored for RESET (uses DEFAULT_RESET_BALANCE)
  status     String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reason     String    @default("MARGIN_CALL") @db.VarChar(64) // MARGIN_CALL
  adminNote  String?  @db.Text
  approvalReason String?  @db.Text
  eventScenario  String?  @db.Text
  equityAt   Float? // snapshot at request time
  marginLvl  Float?
  /// Trader ticked the leveraged-trading risk acknowledgment in the margin-call modal
  riskAcknowledged   Boolean   @default(false)
  riskAcknowledgedAt DateTime?
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  @@index([userId, status])
  @@index([status])
}

/// Singleton-ish global trading rates / risk defaults (id = "default")
/// Trader withdrawal requests — balance debited only after ADMIN approve.
model WithdrawalRequest {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount     Float
  currency   String    @default("USD")
  method     String    @default("BANK") // BANK | CRYPTO
  details    String?   @db.Text // IBAN / wallet
  note       String?   @db.Text
  status     String    @default("PENDING") // PENDING | APPROVED | REJECTED
  adminNote  String?   @db.Text
  approvalReason String? @db.Text
  eventScenario  String? @db.Text
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  @@index([userId, status])
  @@index([status])
}


model TradingSettings {
  id                     String   @id @default("default")
  /// Multiplier on each symbol's built-in absolute spread
  spreadMultiplier       Float    @default(1)
  /// Commission charged per lot on fill (USD)
  commissionPerLot       Float    @default(0)
  /// Default account leverage for new accounts / margin calc fallback
  defaultLeverage        Int      @default(100)
  /// Margin call when marginLevel < this % (used margin > 0)
  marginCallThresholdPct Float    @default(50)
  defaultMinVolume       Float    @default(0.01)
  defaultMaxVolume       Float    @default(100)
  /// Multiplier on contract size for P/L and margin
  defaultContractMult    Float    @default(1)
  updatedAt              DateTime @updatedAt
}

/// Per-symbol overrides for spreads, sizing, enablement
model SymbolSettings {
  id                 String   @id @default(cuid())
  symbol             String   @unique @db.VarChar(191)
  /// Full bid/ask spread in price units (overrides base*multiplier when set)
  spreadAbs          Float?
  spreadMultiplier   Float?
  contractMultiplier Float?
  minVolume          Float?
  maxVolume          Float?
  commissionPerLot   Float?
  enabled            Boolean  @default(true)
  /// Catalog overrides / custom-symbol definition (null = built-in default from src/lib/symbols.ts)
  name               String?  @db.VarChar(191)
  assetClass         String?  @db.VarChar(16)
  digits             Int?
  pipSize            Float?
  /// Base contract size (effective = contractSize × contractMultiplier)
  contractSize       Float?
  /// Fallback price used only when no live quote is available
  basePrice          Float?
  /// Lot step (null = no step enforcement)
  volumeStep         Float?
  /// Chart / quote source ticker (Yahoo Finance)
  yahoo              String?  @db.VarChar(64)
  flag               String?  @db.VarChar(16)
  /// Admin-created symbol (not part of the built-in list)
  isCustom           Boolean  @default(false)
  /// Built-in symbol removed from the catalog (soft delete; custom symbols are hard-deleted)
  deleted            Boolean  @default(false)
  updatedAt          DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String
  admin     User     @relation("AdminAudits", fields: [adminId], references: [id], onDelete: Cascade)
  action    String
  targetId  String?
  note      String?  @db.Text
  meta      String?  @db.Text
  createdAt DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([action])
}

/// Broker desk — CRM organizational unit
model Desk {
  id                String   @id @default(cuid())
  name              String
  code              String?  @unique @db.VarChar(191)
  active            Boolean  @default(true)
  chatStatus        Boolean  @default(true)
  minimalDeposit    Float    @default(0)
  maximumDeposit    Float    @default(100000)
  tradePlatformLink String?
  defaultEmail      String?
  office            String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([active])
}

/// Trading group label for CRM assignment
model TradingGroup {
  id             String   @id @default(cuid())
  name           String   @unique @db.VarChar(191)
  description    String?  @db.Text
  customersCount Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// Ledger of balance-affecting events (deposits, adjustments, margin resets, etc.)
model BalanceLedger {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradingAccountId String?
  type             String // DEPOSIT | WITHDRAWAL | BONUS | CREDIT | ADJUSTMENT | RESET | MARGIN_ADD | TRADE_PNL
  amount           Float
  balanceBefore    Float
  balanceAfter     Float
  currency         String   @default("USD")
  comment          String?  @db.Text
  createdById      String?
  createdByName    String?
  refType          String? // DepositRequest | BalanceRequest | AuditLog
  refId            String?
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type])
  @@index([tradingAccountId])
}

/// CRM communication stub (chat/call notes)
model Communication {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   @default("NOTE") // CHAT | CALL | NOTE
  title       String?
  description String   @db.Text
  workerName  String?
  workerId    String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}


/// Best-effort client activity (e.g. suspected screenshot). Browsers cannot reliably detect OS screenshots.
model ClientActivityEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   @db.VarChar(64) // SCREENSHOT_SUSPECTED
  path      String?  @db.VarChar(512)
  userAgent String?  @db.Text
  meta      String?  @db.Text
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([kind, createdAt])
}

/// KYC / document stub metadata (no binary storage required)
model DocumentRecord {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  docType    String   @default("OTHER") // ID | ADDRESS | SELFIE | OTHER
  status     String   @default("PENDING") // PENDING | APPROVED | REJECTED
  note       String?  @db.Text
  createdAt  DateTime @default(now())
  reviewedAt DateTime?

  @@index([userId, status])
}

/// Calendar reminder stub
model Reminder {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  workerId    String?
  workerName  String?
  body        String   @db.Text
  remindAt    DateTime
  color       String   @default("#3b82f6")
  createdAt   DateTime @default(now())

  @@index([remindAt])
  @@index([userId])
}

/// Singleton app/system settings (id = "default")
model SystemSettings {
  id                String   @id @default("default")
  /// Required invite / referral code for public registration (digits)
  referralCode      String   @default("213950812") @db.VarChar(64)
  /// When true, public registration requires a valid referral code
  referralRequired  Boolean  @default(true)
  /// When true, admins can open the trader terminal as that user (default ON)
  terminalImpersonationEnabled Boolean @default(true)
  /// JSON: { valid: string[], invalid: string[], potential: string[] } saleStatus / potentialStatus lists
  leadStatusMappingJson String? @db.Text
  updatedAt         DateTime @updatedAt
}


/// Time-limited one-time (or multi-use until expiry) auto-login links for traders
model AutoLoginLink {
  id              String    @id @default(cuid())
  token           String    @unique @db.VarChar(64)
  userId          String
  user            User      @relation("AutoLoginTarget", fields: [userId], references: [id], onDelete: Cascade)
  createdById     String?
  createdBy       User?     @relation("AutoLoginCreator", fields: [createdById], references: [id], onDelete: SetNull)
  expiresAt       DateTime
  /// First successful use
  usedAt          DateTime?
  /// Most recent successful use (links are reusable until expiry)
  lastUsedAt      DateTime?
  /// Set when an admin revokes the link early
  revokedAt       DateTime?
  /// Legacy field — redemption is expiry-only (unlimited uses); kept for compatibility
  maxUses         Int       @default(0)
  useCount        Int       @default(0)
  note            String?   @db.VarChar(255)
  /// When true, redeeming this link sets User.mustChangePassword
  forcePasswordReset Boolean  @default(false)
  /// When the client completed forced password set after redeeming this link
  passwordSetAt  DateTime?
  createdAt       DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Email template for CRM outreach
model MailTemplate {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(191)
  subject   String   @db.VarChar(255)
  body      String   @db.Text
  deskId    String?
  deskName  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

/// Sign-in audit trail per user (password, auto-login link, admin impersonation; failures too)
model LoginEvent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  at          DateTime @default(now())
  success     Boolean  @default(true)
  /// password | auto-login | impersonation | register
  method      String   @default("password") @db.VarChar(24)
  /// Failure reason (bad_password, frozen, expired_link, …)
  reason      String?  @db.VarChar(64)
  /// Admin user id for impersonation
  actorId     String?  @db.VarChar(64)
  ip          String?  @db.VarChar(64)
  country     String?  @db.VarChar(8)
  countryName String?  @db.VarChar(96)
  region      String?  @db.VarChar(128)
  city        String?  @db.VarChar(128)
  userAgent   String?  @db.VarChar(512)
  device      String?  @db.VarChar(32)
  browser     String?  @db.VarChar(64)
  os          String?  @db.VarChar(64)

  @@index([userId, at])
  @@index([at])
}

/// Live-support typing / in-chat / read-receipt state (one row per trader).
model ChatThreadState {
  userId              String    @id
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerTypingUntil DateTime?
  adminTypingUntil    DateTime?
  customerInChatUntil DateTime?
  adminInChatUntil    DateTime?
  customerLastReadAt  DateTime?
  adminLastReadAt     DateTime?
  updatedAt           DateTime  @updatedAt
}


/// Live-support chat attachment (sent by staff). Customers can only VIEW it through a
/// short-lived token endpoint (inline, no-store, watermarked viewer); staff can download.
model ChatAttachment {
  id           String   @id @default(cuid())
  /// trader the attachment belongs to (chat thread owner)
  userId       String
  uploadedById String?
  fileName     String   @db.VarChar(255)
  mime         String   @db.VarChar(120)
  size         Int
  data         Bytes    @db.LongBlob
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}
